{
  "version": 3,
  "configurePresets": [
    {
      "name": "core-debug",
      "displayName": "Core Library + Tests (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_GUI": "OFF",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "core-release",
      "displayName": "Core Library + Tests (Release)",
      "inherits": "core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gui-debug",
      "displayName": "Full App + Qt6 GUI (Debug)",
      "inherits": "core-debug",
      "cacheVariables": {
        "BUILD_GUI": "ON"
      }
    },
    {
      "name": "gui-release",
      "displayName": "Full App + Qt6 GUI (Release)",
      "inherits": "gui-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core-debug",
      "configurePreset": "core-debug"
    },
    {
      "name": "core-release",
      "configurePreset": "core-release"
    },
    {
      "name": "gui-debug",
      "configurePreset": "gui-debug"
    },
    {
      "name": "gui-release",
      "configurePreset": "gui-release"
    }
  ],
  "testPresets": [
    {
      "name": "core-debug",
      "configurePreset": "core-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gui-debug",
      "configurePreset": "gui-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gui-release",
      "configurePreset": "gui-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
